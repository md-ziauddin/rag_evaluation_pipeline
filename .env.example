# Copy to .env and fill in. .env is gitignored. Never commit real credentials.
# Every variable the configuration-management doc references appears here.

# ---------------------------------------------------------------------------
# Provider selection — the pipeline reads these to pick concrete implementations
# behind the EmbeddingProvider / LLMProvider / Reranker interfaces.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=bedrock          # bedrock | local
LLM_PROVIDER=groq                   # bedrock | groq | local
RERANKER_PROVIDER=bedrock           # bedrock | local | none

# ---------------------------------------------------------------------------
# Groq API (High-Speed LLM Provider)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile  # or llama3-8b-8192, mixtral-8x7b-32768

# ---------------------------------------------------------------------------
# AWS Bedrock (default provider). Prefer an AWS profile or IAM role over keys.
# Bedrock model IDs carry the provider prefix (e.g. anthropic.*, amazon.*, cohere.*).
# Verify exact IDs, regions, and pricing against current AWS Bedrock docs at build time.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=                # only if not using a profile/role
# AWS_SECRET_ACCESS_KEY=

BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0     # or cohere.embed-english-v3
BEDROCK_LLM_MODEL_ID=anthropic.claude-sonnet-5             # generation + LLM-judge default
BEDROCK_RERANK_MODEL_ID=amazon.rerank-v1:0                 # or cohere.rerank-v3-5; verify region

# ---------------------------------------------------------------------------
# Local open-source models (used when *_PROVIDER=local; always available for benchmarking).
# ---------------------------------------------------------------------------
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_HOME=./data/hf_cache

# ---------------------------------------------------------------------------
# Vector databases (containerized via docker-compose; do not install on the host).
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_URL=localhost:50051
WEAVIATE_API_KEY=

# ---------------------------------------------------------------------------
# Experiment tracking.
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
# Optional LangSmith tracing (SaaS). Leave disabled unless explicitly used.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=rag-eval

# ---------------------------------------------------------------------------
# API service.
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CONFIG_PATH=config/settings.yaml
